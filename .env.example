# ---- model: set ONE key. LLM_PROVIDER picks anthropic|openai (empty = whichever key is set) ----
LLM_PROVIDER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# 1 = server-side refusal fallback on (beta). Set 0 if your account/platform rejects it.
CLAUDE_FALLBACKS=1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# low|medium|high for reasoning models; leave EMPTY for non-reasoning models
OPENAI_REASONING_EFFORT=medium
# responses (default; required for tools + reasoning on gpt-5.x) or chat (Chat Completions, for
# Azure / OpenAI-compatible servers; then leave OPENAI_REASONING_EFFORT empty)
OPENAI_API_STYLE=responses
# optional: Azure OpenAI or any OpenAI-compatible server (e.g. http://localhost:8080/v1)
OPENAI_BASE_URL=

# ---- which systems to watch (deploy = smoke probe of the service + Argo CD) ----
HEAL_SOURCES=deploy,github,jenkins,airflow
HEAL_LOOKBACK_HOURS=24
HEAL_WAIT_TIMEOUT=900
# github_issue (needs GitHub below) or stdout
HEAL_ESCALATION=github_issue

# ---- GitHub Actions ------------------------------------------------------------
GITHUB_REPO=your-user/selfheal-demo
# leave empty to use `gh auth token`
GITHUB_TOKEN=
GITHUB_WORKFLOW=ci.yml

# ---- Jenkins ---------------------------------------------------------------------
# JENKINS_TOKEN is the admin PASSWORD infra/compose.yaml creates (an API token also works later).
# If port 8081 is taken, change JENKINS_PORT and the port in JENKINS_URL together.
JENKINS_PORT=8081
JENKINS_URL=http://localhost:8081
JENKINS_USER=admin
JENKINS_TOKEN=change-me-jenkins
JENKINS_JOB=traffic-api-ci

# ---- Argo CD (infra/up.sh fills in ARGOCD_PASSWORD) ----------------------------
ARGOCD_URL=https://localhost:30443
ARGOCD_USER=admin
ARGOCD_PASSWORD=
ARGOCD_APP=traffic-api
ARGOCD_VERIFY_TLS=false

# ---- Airflow 3 -----------------------------------------------------------------
# If port 8082 is taken, change AIRFLOW_PORT and the port in AIRFLOW_URL together.
AIRFLOW_PORT=8082
AIRFLOW_URL=http://localhost:8082
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_DAG=traffic_probe_daily

# ---- the delivered service -----------------------------------------------------
SERVICE_URL=http://localhost:30080
SMOKE_P95_MS=800
SMOKE_MAX_ERROR_PCT=1.0

# approval prompts: empty = ask at the keyboard; yes/no = unattended
AUTO_APPROVE=
